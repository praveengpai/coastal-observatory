# Copy to .env and fill in. Never commit .env.
OBS_ENVIRONMENT=production
OBS_SECRET_KEY=            # 64 random characters: python -c "import secrets;print(secrets.token_urlsafe(48))"
OBS_DB_PASSWORD=           # strong random password
OBS_TOKEN_HOURS=8

# ODK Central (an account with Project Viewer role is enough for syncing; Project Manager to publish sites)
OBS_ODK_URL=https://odk.example.gov.in
OBS_ODK_PROJECT_ID=1
OBS_ODK_EMAIL=
OBS_ODK_PASSWORD=

# Weather location (default Kochi)
OBS_WEATHER_LAT=9.9816
OBS_WEATHER_LON=76.2999

# TLS certificate folder holding fullchain.pem and privkey.pem
OBS_TLS_DIR=./deploy/tls

# Optional: Sarvam AI for English → Malayalam message translation (team-written text only, never personal data)
OBS_SARVAM_API_KEY=
OBS_SARVAM_MODEL=sarvam-translate:v1

# Free option: use KoboToolbox instead of self-hosted ODK Central
# OBS_FORM_SERVER=kobo
# OBS_KOBO_URL=https://kf.kobotoolbox.org
# OBS_KOBO_TOKEN=
# OBS_KOBO_ASSETS=obs_camp_registration=<uid>,obs_camp_station=<uid>,obs_household_visit=<uid>,obs_water_sample=<uid>
